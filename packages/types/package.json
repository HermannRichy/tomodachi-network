{
  "name": "@tomodachi/types",
  "version": "0.1.0",
  "private": true,
  "description": "Types et schémas Zod partagés entre l'API, le web et le mobile.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tomodachi/config": "workspace:*",
    "typescript": "~6.0.3"
  }
}
