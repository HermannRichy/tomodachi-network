{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "@tomodachi/design-tokens#build": {
      "outputs": [
        "theme.css",
        "nativewind.css",
        "tailwind-preset.cjs",
        "src/tokens.ts",
        "../../apps/mobile/src/global.css"
      ]
    }
  }
}
